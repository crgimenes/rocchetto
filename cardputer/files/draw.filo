(title (dir))
(let ((n (entry-count (dir))))
  (if (= n 0)
    (print-at 2 1 "(empty)")
    (map
      (fn (i)
        (let ((idx (+ top i)))
          (if (< idx n)
            (letv (path heading date size) (entry-at (dir) idx)
              (let ((name (name-of path))
                    (sz (size-text size))
                    (room (- W (str-len sz) 1))
                    (row (+ 1 i)))
                (if (= idx sel) (do (attr A_REV) (fill row 0 1 W " ")))
                (print-at row 0 (str-sub name 0 (math-min room (str-len name))))
                (print-at row (- W (str-len sz)) sz)
                (attr 0))))))
      (range (rows)))))
(hint-bar "; . pick  , / dir")
